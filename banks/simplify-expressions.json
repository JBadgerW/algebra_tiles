{
  "title": "Simplifying Expressions",
  "description": "Combine like terms and use the distributive property.",
  "order": 2,
  "pairs": [
    { "q": "$3x + 5x$", "a": "$8x$" },
    { "q": "$2(x + 4)$", "a": "$2x + 8$" },
    { "q": "$7y - 2y + 3$", "a": "$5y + 3$" },
    { "q": "$-3(x - 2)$", "a": "$-3x + 6$" },
    { "q": "$4a + 3b - a + b$", "a": "$3a + 4b$" },
    { "q": "$x^2 + 3x^2$", "a": "$4x^2$" },
    { "q": "$5(2m - 1)$", "a": "$10m - 5$" },
    { "q": "$6 - (x + 2)$", "a": "$4 - x$" },
    { "q": "$x \\cdot x \\cdot x$", "a": "$x^3$" },
    { "q": "$\\dfrac{12x}{4}$", "a": "$3x$" },
    { "q": "$2(x + 3) + 4x$", "a": "$6x + 6$" },
    { "q": "$9n - 9n + n$", "a": "$n$" },
    { "q": "$-(4 - p)$", "a": "$p - 4$" },
    { "q": "$3(x + y) - 2y$", "a": "$3x + y$" }
  ]
}
